1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","kia",{"project":{"slug":"kia","number":"09","title":"Kia — от тендера к системе email-коммуникаций","shortTitle":"Kia","group":"systems","discipline":"Руководство дизайном · Email","summary":"Руководил дизайном для выигранного агентством тендера, затем вместе с командой развивал систему писем Kia.","role":"Руководство дизайном, личная разработка макетов, компонентная система","client":"Kia, через Inbox Marketing","format":"Работа в агентстве","context":["В начале 2024 года руководил подготовкой дизайна для тендера Kia, который выиграло Inbox Marketing. Организовывал брейнштормы от получения задачи до финальной отправки предложения, контролировал производство и качество, создавал макеты лично и распределял задачи между дизайнерами.","После тендера мы продолжили развивать email-коммуникации. Исходные письма использовали визуалы других региональных рынков и слабо различались по типам сообщений."],"sections":[{"title":"Автомобиль и предложение — в центре","paragraphs":["Переработал структуру и вместе с командой выстроил визуальный язык, согласованный с российским сайтом Kia. Укрупнили изображения автомобилей, сделали типографику читаемее и выделили модельный ряд.","Масла оформили в отдельные товарные карточки с описаниями. Содержание разделили на понятные блоки под разные задачи рассылки."]},{"title":"Система и ограниченный фотобанк","paragraphs":["Создал внутреннюю компонентную систему в Figma. Дизайнеры могли собирать письмо из готовой структуры и уделять больше времени визуалу и подаче предложения.","При ограниченном фотобанке использовали официальные и предоставленные клиентом изображения, разные кропы и нейросети: генерировали людей и меняли фон, показывая продукты в разных окружениях."]},{"title":"Общее понимание с заказчиком","paragraphs":["В начале работы подробно обсуждали с клиентом его ожидания и требования. По моему наблюдению, к концу работы Kia получал меньше всего клиентских правок среди проектов команды: у нас и заказчика сложилось общее понимание структуры и визуального языка писем."]}],"outcome":["Агентство выиграло тендер и продолжило работу над коммуникациями Kia.","Команда получила визуальную и компонентную систему для разных типов писем. Приведённые материалы показывают последующие коммуникации."],"credits":"Я руководил работой, создавал часть макетов и контролировал качество. Дизайн разрабатывали вместе с командой; маркетинговые сценарии — маркетологи и проджекты."}}]]
