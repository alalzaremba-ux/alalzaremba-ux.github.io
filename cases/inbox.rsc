1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","inbox",{"project":{"slug":"inbox","number":"05","title":"Inbox Marketing — дизайн-система и развитие отдела","shortTitle":"Inbox Marketing","group":"systems","discipline":"Дизайн-система · Руководство","summary":"Разработал и внедрил систему производства email-коммуникаций, организовал обучение и возглавил отдел из трёх дизайнеров.","role":"Разработка и внедрение дизайн-системы, обучение, руководство отделом из трёх дизайнеров","client":"Inbox Marketing","format":"Работа в агентстве","context":["В регулярном производстве email-коммуникаций дизайнеры тратили время на повторяющиеся задачи: структуру письма, оформление текста и подготовку стандартных блоков. Первая итерация макета занимала в среднем четыре часа.","Я разработал в Figma дизайн-систему: структурированные блоки, правила типографики и библиотеку визуалов. Готовые элементы позволяли уделять больше времени содержанию и подаче конкретного предложения."],"sections":[{"title":"Компоненты и подготовка контента","paragraphs":["Внедрил библиотеку в работу дизайнеров и маркетологов. Для подготовки контента создал отдельный набор черновых блоков: маркетолог определял структуру письма и размещал текст, а дизайнер продолжал работу с подготовленным макетом.","По учёту времени в Битрикс, после внедрения системы первая итерация дизайна письма занимала примерно от 40 минут до двух часов. Сравнение относится к первому макету; последующие правки учитывались отдельно."]},{"title":"Руководство отделом","paragraphs":["Внедрение системы стало основанием для моего повышения. До этого я работал под руководством арт-директора. После разделения направлений она сосредоточилась на айдентике и вебе, а я возглавил отдел остальных клиентских коммуникаций с прямым подчинением двум собственникам агентства.","Распределял задачи между тремя дизайнерами с учётом навыков и загрузки. На еженедельных встречах мы разбирали сложные работы, обсуждали улучшения и планировали следующие задачи. За постоянными клиентами закрепляли дизайнеров, знакомых с их требованиями.","Контролировал загрузку и организовывал передачу проектов между дизайнерами. В начале работы с Kia распределил задачи внутри команды, чтобы снизить нагрузку на специалиста, который до этого вёл проект самостоятельно."]},{"title":"Найм и адаптация","paragraphs":["Совместно с HR отвечал за найм: определял профессиональные требования, оценивал резюме и портфолио после первичного скрининга, разрабатывал тестовые задания и проверял их выполнение.","По этому процессу мы наняли junior-дизайнера. Я сопровождал его адаптацию три месяца: сначала выделял больше времени на задачи, в первый месяц проверял каждый макет и подробно объяснял требования клиентов, композицию и типографику. Дизайнер успешно прошёл испытательный срок и освоил обычные задачи команды."]},{"title":"Развитие услуги «Мастер-шаблон»","paragraphs":["Предложил формат работы для клиентов с ограниченным бюджетом на регулярные рассылки: разработку мастер-шаблона. Команда проектировала и согласовывала набор блоков в Figma, затем передавала его в вёрстку. На этой основе маркетолог мог самостоятельно собирать письма в редакторе.","За шесть месяцев агентство привлекло на эту услугу 13 клиентов. Мастер-шаблоны стали дополнительным источником дохода и позволили клиентам выпускать рассылки без участия дизайнера в каждом выпуске."]}],"outcome":["Первая итерация письма: примерно 40 минут–2 часа вместо прежних четырёх часов в среднем, по учёту времени в Битрикс.","Команда из трёх дизайнеров получила общие компоненты, регулярные ревью и понятный порядок передачи задач.","На предложенную мной услугу «Мастер-шаблон» агентство привлекло 13 клиентов за шесть месяцев."],"credits":"Дизайн-система и обучение — моя работа. Найм проводил совместно с HR; клиентские проекты и развитие услуги — работа команды Inbox Marketing.","stat":{"value":"40 мин–2 ч","label":"на первую итерацию письма после внедрения системы"}}}]]
