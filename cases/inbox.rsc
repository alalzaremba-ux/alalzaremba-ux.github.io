3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Inbox Marketing — Дизайн-система и команда — Алексей Заремба"}],["$","meta","1",{"name":"description","content":"Разработал и внедрил библиотеку компонентов в Figma, организовал подготовку писем и обучение команды. Затем возглавил отдел из трёх дизайнеров."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["cases","inbox"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"cases","fallback":[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","main",null,{"id":"main","className":"archive-main missing-folder","children":[["$","span",null,{"className":"mono","children":"404 / СТРАНИЦА НЕ НАЙДЕНА"}],["$","h1",null,{"children":["Такой страницы",["$","br",null,{}],"здесь нет."]}],["$","a",null,{"href":"/","children":"← Назад в портфолио"}]]}]],"children":["$","$La",null,{"resetKey":"[\"cases\",\"slug|inbox|d\"]","fallback":[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","main",null,{"id":"main","className":"archive-main missing-folder","children":[["$","span",null,{"className":"mono","children":"404 / СТРАНИЦА НЕ НАЙДЕНА"}],["$","h1",null,{"children":["Такой страницы",["$","br",null,{}],"здесь нет."]}],["$","a",null,{"href":"/","children":"← Назад в портфолио"}]]}]],"children":["$","$Le",null,{"children":["$","$Lf",null,{"children":[["$","$L8",null,{"providerId":"page:/cases/inbox","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/cases/inbox"}]}],null]}]}]}]}]}]}]}]}],null,null]
