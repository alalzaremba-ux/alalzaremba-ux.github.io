1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","vsk",{"project":{"slug":"vsk","number":"11","title":"ВСК — конструктор добрых пожеланий","shortTitle":"ВСК","group":"digital","discipline":"UX · Интерактивный спецпроект","summary":"Спроектировал UX конструктора открыток, который связывал новогоднее поздравление с благотворительностью.","role":"UX, структура лендинга и проработка механики вместе с разработчиком","client":"ВСК, через Inbox Marketing","period":"2023","format":"Работа в агентстве","context":["В новогоднем спецпроекте ВСК пользователь мог собрать собственную открытку и поддержать фонд «Арифметика добра». Я отвечал за UX благотворительного лендинга: структуру сайта и проработку механики конструктора."],"sections":[{"title":"Собрать своё поздравление","paragraphs":["Пользователь выбирал фон, персонажа, детали и пожелание, собирая поздравление из готовых элементов. Вместе с верстальщиком обсуждал, как реализовать настройку открытки и учесть технические ограничения.","Визуальное оформление и иллюстрации создавала дизайнер-иллюстратор."]},{"title":"Как работала благотворительная механика","paragraphs":["Для скачивания открытки пользователь оставлял email. За каждый новый email ВСК перечисляла 10 рублей в фонд «Арифметика добра».","Личное пожертвование пользователя было отдельной возможностью."]}],"outcome":["Команда запустила проект, и клиент положительно оценил результат."],"credits":"Мой вклад — UX и структура, проработка механики вместе с разработчиком. Иллюстрации и визуальная часть — дизайнер-иллюстратор; код — разработчик."}}]]
