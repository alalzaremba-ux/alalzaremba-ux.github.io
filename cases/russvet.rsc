1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","russvet",{"project":{"slug":"russvet","title":"Русский Свет","shortTitle":"Русский Свет","group":"concepts","discipline":"Презентации / Оформление событий","summary":"Презентация B2B-решений и оформление корпоративного события","role":"Структура презентации, визуальная концепция, дизайн макетов и подготовка файлов.","client":"Русский Свет · концепция по брифу","period":"2026","format":"5 слайдов, приглашение А4, растяжка 4:1","context":["Подготовить B2B-презентацию о модернизации освещения и оформление корпоративных гонок: приглашение А4 и растяжку 4:1. Основа — бриф, логотипы и палитра компании."],"sections":[{"title":"Презентация","paragraphs":["Выстроил пять слайдов: тема, промышленный пример, экономия, условия эксплуатации и сопровождение проекта. Энергопотребление сравнил двумя полосами с общей шкалой; расчётную окупаемость и прогноз показал отдельно. Разделил технические показатели по смыслу и сохранил пояснение, что проценты не складываются."]},{"title":"Оформление события","paragraphs":["Приглашение объединяет крупное название, фотографию команды и блок с датой, временем и местом. Для растяжки 4:1 пересобрал композицию: название и год — на синем поле, логотипы организатора и партнёра — в белой колонке. Цвет, типографика и тема движения на воде связывают оба носителя."]}],"outcome":["Пять слайдов, приглашение и растяжка. В Figma — редактируемые макеты, текстовые и цветовые стили; подготовлены PDF, печатные версии и PSD растяжки с векторными смарт-объектами. Текст редактируется в Figma; в PSD он сохранён контурами.","Концептуальный проект по брифу компании. Показатели условные; использование макетов компанией не подтверждено."],"credits":"Дизайн — Алексей Заремба. Логотипы и исходное содержание — материалы компании. Фотографии использованы из материалов проекта; авторство снимков не заявляется.","status":"Концептуальный проект по брифу компании","number":"02"}}]]
