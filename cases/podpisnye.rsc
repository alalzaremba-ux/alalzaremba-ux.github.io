1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","podpisnye",{"project":{"slug":"podpisnye","number":"02","title":"«Подписные издания» — концепция мерча","shortTitle":"«Подписные издания»","group":"concepts","discipline":"Исследование · Концепция · Мерч","summary":"Концепция мерча для книжного магазина: современный образ Пушкина, система носителей, сезонные коллекции и туристическая линейка.","role":"Полевое исследование, концепция, предложения по ассортименту и визуальная подача","client":"Концепция для «Подписных изданий»","format":"Конкурсное предложение · Горизонт коллекций — 2026","status":"Концепция для конкурсного отбора","context":["По приглашению дизайнеров из Петербурга участвовал в конкурсной разработке мерча для «Подписных изданий» на 2026 год. Предложил визуальную концепцию, которая связывает литературный характер магазина с повседневными интересами аудитории и развивается в систему коллекций.","Исходная концепция заняла около двух дней: день на поездку и полевое исследование, день на сборку концепции и презентации. Последующая доработка портфолио в этот срок не входит."],"sections":[{"title":"Полевое исследование","paragraphs":["Провёл беседы с продавцами об ассортименте, спросе и возможных новых товарах. Наблюдал за тем, что посетители рассматривают и выбирают; фиксировал наблюдения в записях, фотографиях и видео.","Обобщил наблюдения и сформулировал гипотезы об интересах аудитории. Качественное исследование стало отправной точкой для персонажа и ассортиментных предложений."]},{"title":"Персонаж и система носителей","paragraphs":["Разработал концепцию с современным образом Пушкина, через которого литературная тема соединяется с повседневным общением.","Предложение объединяло шоперы, стикеры, значки, открытки, закладки, блокноты, футболки и мягкую игрушку. Для носителей показал варианты применения визуальной системы и возможные материалы изготовления."]},{"title":"Система коллекций на год","paragraphs":["Развил предложение в годовую структуру ассортимента: сезонные темы, форматы подарков и отдельную линейку для туристов.","Единая концепция объединяет разные носители и допускает обновление ассортимента в течение года."]}],"outcome":["Предложение не победило в конкурсном отборе.","В полученной обратной связи отмечались системный подход, туристическая линейка, полевое исследование и визуальная подача."],"credits":"Исследование, концепция, ассортиментные предложения и презентация — моя работа. Представленные изображения показывают концепцию мерча.","stat":{"value":"≈ 2 дня","label":"на исходное исследование и концепцию"}}}]]
