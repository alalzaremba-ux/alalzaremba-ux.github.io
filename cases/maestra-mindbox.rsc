1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","maestra-mindbox",{"project":{"slug":"maestra-mindbox","number":"06","title":"Maestra / Mindbox — библиотека попапов","shortTitle":"Maestra / Mindbox","group":"digital","discipline":"UI-дизайн · Адаптивы · Игровые механики","summary":"Библиотека из десяти попапов для маркетинговых сценариев: состояния, взаимодействие и адаптивные версии.","role":"UI-дизайн десяти шаблонов, состояния и адаптивы; совместная работа с маркетологом","client":"Maestra / Mindbox, через Inbox Marketing","format":"Работа в агентстве · Около трёх недель","context":["Для Maestra требовались шаблоны попапов, которые клиенты платформы могли бы адаптировать под свои сайты и маркетинговые задачи. Позднее дизайн адаптировали для Mindbox.","В набор вошли формы подписки и обратной связи, товарные подборки, уведомления о поступлении товара, предложения с таймером и игровые механики: колесо фортуны, слот-машина и выбор подарка."],"sections":[{"title":"Сценарии и повторное использование","paragraphs":["На этапе концепции рассмотрел около 25 вариантов, исследовал сценарии и подготовил визуальные направления. Содержание и поведение интерфейсов уточнял совместно с маркетологом и представителем клиента.","Главной задачей было сделать шаблоны выразительными и пригодными для повторного использования разными брендами. Предусмотрел замену текстов и изображений, изменение набора полей и оформление под разные сайты."]},{"title":"Состояния и взаимодействие","paragraphs":["Лично разработал дизайн десяти выбранных шаблонов: экраны ввода данных и подтверждения, состояния полей и интерактивных элементов.","Для игровых механик спроектировал последовательность состояний, включая наведение на подарок, открытие коробки и показ приза. Взаимодействие соответствовало исходному документу с требованиями."]},{"title":"Адаптивная композиция","paragraphs":["Подготовил версии для компьютера, планшета и телефона. Крупный боковой креатив становился верхним блоком мобильной формы, а игровые элементы получали подходящее для экрана расположение.","Визуалы собирал из стоковых материалов, в том числе Freepik, изображений, созданных нейросетями, и собственной дорисовки."]}],"outcome":["За примерно три недели подготовил дизайн десяти шаблонов и передал его разработчикам Mindbox. На этапе передачи макеты приняли без дополнительных правок к дизайну.","Один из шаблонов использован в демонстрации обновлённого редактора Mindbox: в видео показаны настройка полей и отдельное оформление мобильной версии."],"credits":"Дизайн попапов — моя работа в связке с маркетологом. Разработка и интерфейс редактора — команда Mindbox.","stat":{"value":"10","label":"шаблонов с адаптивами и состояниями"}}}]]
