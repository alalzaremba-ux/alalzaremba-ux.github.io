1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","technonicol",{"project":{"slug":"technonicol","number":"10","title":"Технониколь — письма и спецпроекты","shortTitle":"Технониколь","group":"digital","discipline":"Email · Руководство дизайном · Лендинг","summary":"Разработка продуктовых писем и конкурсного лендинга, руководство дизайном сезонных спецпроектов Технониколь.","role":"Дизайнер, затем руководитель отдела: личные макеты, постановка задач и контроль качества","client":"Технониколь, через Inbox Marketing","format":"Работа в агентстве","context":["Работал с Технониколь как дизайнер, затем как руководитель отдела. Вместе с маркетологами развивал визуальные концепции под конкретные продукты и события, готовил брифы и мудборды, перерабатывал иерархию содержания."],"sections":[{"title":"Визуальные концепции","paragraphs":["Разработал три самостоятельные визуальные концепции: комиксную подачу письма о герметиках, конкурсное письмо с Avito и поздравление ко дню рождения компании с объёмной праздничной графикой.","В проекте «Масштабируйте свой бизнес» руководил дизайнером-иллюстратором и контролировал качество визуального рассказа."]},{"title":"Календарь и корпоративный Новый год","paragraphs":["В спецпроектах календаря-2024 и корпоративного Нового года участвовал в согласовании ТЗ с клиентом и приёмке работы.","Дизайнеры моей команды разработали три письма: промо календаря, доступ к бэкстейджу и приглашение."]},{"title":"«Стройка на миллион»","paragraphs":["Самостоятельно подготовил в Figma редизайн лендинга ежегодного конкурса. Обновил визуальную подачу и сделал структуру понятнее, соблюдая требования подробного ТЗ.","Подготовил и передал дизайн-макет за 2–3 дня. По моей оценке, на согласование потребовалось две-три правки."]}],"outcome":["За период работы клиент расширил число заказов, в том числе передал агентству конкурсные лендинги.","По моему наблюдению, к концу работы клиентских правок стало значительно меньше: вместе с командой наладили взаимодействие с заказчиком."],"credits":"Письма о герметиках, конкурс с Avito, день рождения компании и макет лендинга — моя работа. Иллюстрации в «Масштабируйте свой бизнес» и три письма сезонных спецпроектов — работа дизайнеров команды под моим руководством."}}]]
