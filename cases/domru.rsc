1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","domru",{"project":{"slug":"domru","number":"07","title":"Дом.ру — обновление email-коммуникаций","shortTitle":"Дом.ру","group":"systems","discipline":"Руководство дизайном · Email","summary":"Провёл анализ прежних писем и руководил обновлением email-коммуникаций в соответствии с брендбуком Дом.ру.","role":"Анализ коммуникаций, согласование требований, постановка задачи и руководство дизайном","client":"Дом.ру, через Inbox Marketing","format":"Работа в агентстве","context":["При возобновлении сотрудничества с Дом.ру отвечал за дизайн со стороны агентства. Проанализировал структуру и визуальную иерархию прежних писем, согласовал требования с маркетологами клиента и подготовил техническое задание для команды."],"sections":[{"title":"Блочная система и новые 3D-материалы","paragraphs":["На основе брендбука команда разработала модульную систему email-коммуникаций. Я руководил работой и проверял структуру, иерархию и соответствие макетов согласованным требованиям.","Клиент передал набор из 20 изображений с роутерами и маскотом. Команда дополнила его 3D-материалами в Spline. Часть созданных агентством изображений вошла в брендбук клиента и использовалась в дальнейших рассылках."]}],"outcome":["Обновлённые письма получили общую структуру и расширенный набор визуалов. По моему наблюдению, подробный брифинг помог работать с небольшим количеством правок."],"credits":"Макеты и 3D-материалы создала команда Inbox Marketing. Мой вклад — постановка задачи, руководство и контроль качества. Прежние письма показаны для контекста."}}]]
