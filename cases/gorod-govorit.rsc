1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","gorod-govorit",{"project":{"slug":"gorod-govorit","number":"01","title":"Город говорит — визуальное эссе","shortTitle":"Город говорит","group":"concepts","discipline":"Визуальное эссе · Типографика · Презентация","summary":"Перевёл городские надписи и знаки в плакатную типографику. Собрал визуальное эссе на основе фотографий Viktor Balaguer.","role":"Концепция, отбор фотографий, структура, тексты и дизайн презентации","client":"Самостоятельный проект","period":"2026","format":"Визуальное эссе · 12 слайдов · 16:9","context":["Город обращается к человеку через вывески, таблички, названия и следы на стенах. В уличных фотографиях Viktor Balaguer эти сообщения соседствуют с повседневной жизнью: запрет стоит рядом с купающимися людьми, а свет витрины приглашает с холодной улицы внутрь.","Я собрал из этих наблюдений самостоятельное визуальное эссе. Задача — выстроить короткую историю, в которой фотография и типографика вместе передают интонацию города."],"sections":[{"title":"От уличного наблюдения к истории","paragraphs":["Выстроил последовательность от материала надписи — камня, краски, кузова — к её действию: запрету, направлению и приглашению. Затем перешёл к имени места, слоям городской поверхности и человеку, который по-своему читает эти сообщения.","Чередовал фотографические развороты с плакатными композициями. Крупный кадр даёт рассмотреть уличную сцену, а короткое слово выделяет смысл и меняет темп просмотра."]},{"title":"Слово как форма","paragraphs":["В «ИМЯ» увеличил буквы до границ цветных полей. В «СЛОЙ» использовал повтор, перекрытие и разрезы, соотнося типографику с фактурой стены. В «ЧЕЛОВЕК» разделил слово между тремя фотографиями, чтобы собрать разные уличные эпизоды в одну композицию.","Плотный рисунок Russo One, ограниченная палитра и общая сетка связывают слайды. Масштаб букв, кадрирование и свободное поле меняются вместе с интонацией: от команды к приглашению и тихому финалу."]}],"outcome":["Визуальное эссе на 12 слайдах. Концепция, отбор, последовательность и типографическая интерпретация собраны в единую презентацию."],"credits":"Концепция, структура и дизайн — Алексей Заремба. Фотографии — Viktor Balaguer.","status":"Самостоятельный проект"}}]]
