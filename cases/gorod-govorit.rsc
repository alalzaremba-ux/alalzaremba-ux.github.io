1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","gorod-govorit",{"project":{"slug":"gorod-govorit","number":"01","title":"Город говорит. Визуальное эссе","shortTitle":"Город говорит","group":"concepts","discipline":"Визуальное эссе · Типографика · Презентация","summary":"Собрал визуальное эссе о городских надписях и людях. Фотографии Viktor Balaguer связал с короткими словами и плакатной типографикой.","role":"Концепция, отбор фотографий, структура, тексты и дизайн презентации","client":"Самостоятельный проект","period":"2026","format":"Визуальное эссе · 12 слайдов · 16:9","context":["Город обращается к нам через вывески, таблички и надписи на стенах. На фотографиях Viktor Balaguer рядом с ними идёт своя жизнь: люди купаются возле запрещающего знака, а свет витрины приглашает зайти с холодной улицы.","Я отобрал фотографии и собрал из них историю о городе и человеке. Короткие слова помогают связать кадры и задать разный темп просмотра."],"sections":[{"title":"От уличного наблюдения к истории","paragraphs":["Начал с поверхностей, на которых появляются надписи: камня, краски и кузова. Дальше показал, как город запрещает, указывает путь и приглашает зайти. В конце серии внимание переходит к человеку, который живёт среди этих знаков.","Чередовал фотографии с плакатными слайдами. На одном развороте можно рассмотреть уличную сцену, на следующем всё внимание забирает короткое слово."]},{"title":"Слово как форма","paragraphs":["В «ИМЯ» увеличил буквы почти до границ цветных полей. В «СЛОЙ» повторил слово, перекрыл и разрезал буквы, как надписи на стене. А «ЧЕЛОВЕК» разделил между тремя фотографиями, чтобы связать разные уличные истории.","Во всей серии использовал Russo One, общую сетку и несколько основных цветов. Менял размер букв, кадрирование и количество свободного места, чтобы каждый слайд звучал по-своему."]}],"outcome":["12 слайдов о городских надписях и людях. В серии чередуются уличные фотографии, короткие фразы и плакатные композиции."],"credits":"Концепция, структура и дизайн: Алексей Заремба. Фотографии: Viktor Balaguer.","status":"Самостоятельный проект"}}]]
