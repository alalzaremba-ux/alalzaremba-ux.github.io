1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","gorod-govorit",{"project":{"slug":"gorod-govorit","number":"01","title":"Город говорит. Визуальное эссе","shortTitle":"Город говорит","group":"concepts","discipline":"Визуальное эссе · Типографика · Презентация","summary":"Визуальное эссе о языке города. Уличная фотография и плакатная типографика раскрывают тему через вывески, запреты и повседневные сцены.","role":"Концепция, отбор фотографий, структура, тексты и дизайн презентации","client":"Самостоятельный проект","period":"2026","format":"Визуальное эссе · 12 слайдов · 16:9","context":["Вывески, таблички и надписи на стенах формируют язык города. В фотографиях Viktor Balaguer этот язык встречается с повседневной жизнью: люди купаются рядом с запрещающим знаком, а свет витрин меняет восприятие холодной улицы.","Задача проекта: раскрыть эти наблюдения в коротком визуальном эссе. Я отвечал за отбор фотографий, последовательность слайдов, тексты и графическую систему презентации."],"sections":[{"title":"Драматургия серии","paragraphs":["Последовательность ведёт от надписей и поверхностей к тому, как город обращается к человеку: запрещает, направляет и приглашает. Ближе к финалу уличные знаки уступают место людям. Сердце на стекле завершает эту историю личным жестом.","Ритм строится на чередовании фотографических сцен и типографических акцентов. Крупные слова задают темы, а следующие за ними кадры раскрывают их через конкретные уличные ситуации."]},{"title":"Слово как форма","paragraphs":["Типографика продолжает содержание фотографии. В «ИМЯ» масштаб букв превращает слово в цветовую композицию. В «СЛОЙ» повтор и перекрытия передают структуру исписанной стены. Слово «ЧЕЛОВЕК», разделённое между тремя кадрами, объединяет самостоятельные сцены в один разворот.","Единство серии поддерживают Russo One, общая сетка и ограниченная палитра. Масштаб текста и свободное поле меняют интонацию: плотные плакатные композиции чередуются с паузами и открытыми фотографическими разворотами."]}],"outcome":["Презентация из 12 слайдов в формате 16:9. Отбор кадров, драматургия и типографическая система раскрывают тему города через отношения между знаком и человеком."],"credits":"Концепция, структура и дизайн: Алексей Заремба. Фотографии: Viktor Balaguer.","status":"Самостоятельный проект"}}]]
