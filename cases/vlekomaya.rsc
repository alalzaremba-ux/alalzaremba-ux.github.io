1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","vlekomaya",{"project":{"slug":"vlekomaya","number":"03","title":"VLEKOMAYA — презентация для Trend Island","shortTitle":"VLEKOMAYA","group":"concepts","discipline":"Структура · Тексты · Презентация","summary":"Собрал историю бренда вокруг вопросов потенциального партнёра и показал развитие ассортимента до фотосъёмки.","role":"Анализ, структура, работа с текстами, дизайн и дополнительные визуалы","client":"VLEKOMAYA","period":"30 июля — 13 августа 2026","format":"Фриланс · Партнёрская презентация","context":["Владельцы VLEKOMAYA, бренда нижнего белья и домашней одежды, хотели представить продукцию в московском Trend Island. С предыдущей презентацией бренд не прошёл отбор.","Ко мне обратились за новой подачей: полно раскрыть небольшой ассортимент и показать, как развивается бренд — от текущих моделей до новых лекал и планов расширения линейки."],"sections":[{"title":"Структура вокруг вопросов партнёра","paragraphs":["Разобрал прежнюю презентацию и предложил новую структуру: ассортимент, отличие бренда, покупатель и материалы, показывающие спрос на офлайн-примерку. Подготовил отдельный документ со структурой и согласовал подход с владельцами.","Составил бриф из девяти пунктов. Запросил данные об аудитории, ценах, размерах и производстве, материалы новых моделей, фотографии, публикации блогеров и обращения покупателей.","Владельцы предоставили исходные данные и тексты о бренде. На этой основе я работал над текстами и собрал в Figma презентацию, пригодную для отправки разным партнёрам и пространствам."]},{"title":"Ассортимент, который можно рассмотреть","paragraphs":["В новой версии ассортимент показан вместе с ценовым позиционированием, особенностями посадки, производством и планами развития линейки. Фотографии сочетаются с информационными блоками, таблицами и lookbook.","Для части новых изделий ещё не было фотографий: одежда уже отшивалась, но съёмку пока не провели. По переданным клиентом лекалам подготовил промпты и сгенерировал изображения, сохранив образ той же модели и стилистику фотографий бренда. Эти визуализации вошли в финальную презентацию."]},{"title":"Работа напрямую с владельцами","paragraphs":["По обратной связи уточнял контраст, фотографии на обложке и подборку на слайде с визуальным кодом. Отдельно обсудил предметную подачу и фотографии на моделях, затем собрал вариант из выбранных клиентом кадров.","Финальный PDF передал 13 августа. Период с 30 июля по 13 августа включает сбор материалов и согласование."]}],"outcome":["Вместо прежней имиджевой презентации на девять страниц подготовлена партнёрская презентация на 12 слайдах.","Последний известный мне результат: бренд прошёл первичный отбор и остался на рассмотрении среди потенциальных партнёров Trend Island. Итоговое решение о размещении продукции мне неизвестно."],"credits":"Анализ, структура, работа с текстами, дизайн и промпты — моя работа. Исходные данные и тексты предоставили владельцы. Одежда, лекала и исходные фотографии созданы другими авторами; дополнительные изображения новых изделий — сгенерированные визуализации.","stat":{"value":"12","label":"слайдов партнёрской презентации"}}}]]
