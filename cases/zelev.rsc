1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","zelev",{"project":{"slug":"zelev","number":"04","title":"«Павелецкая Сити» — презентация интерьера","shortTitle":"«Павелецкая Сити»","group":"concepts","discipline":"Структура · Презентация · Коммуникация","summary":"Превратил разрозненные визуализации и пояснения в маршрут по квартире и основу для обсуждения проекта.","role":"Бриф, организация материалов, структура, оформление и чек-лист для обратной связи","client":"Zelev Bureau","format":"Фриланс · Презентация интерьерного проекта","context":["Дизайнер интерьера обратился ко мне из-за сложной коммуникации с требовательными заказчиками. Отдельные рендеры с короткими пояснениями не помогали владельцам квартиры понять планировочные и художественные решения. Пожелания дополнялись по ходу работы, объём информации рос, согласование шло трудно.","Нужна была презентация, которая свяжет решения в понятный рассказ и поможет дизайнеру договориться с клиентами, сохранив важные детали проекта."],"sections":[{"title":"Последовательный маршрут по квартире","paragraphs":["Провёл бриф с дизайнером интерьера, разобрал разрозненные визуализации и голосовые пояснения. Выстроил презентацию как последовательный маршрут по помещениям.","Визуализации сопровождались пояснениями функционала и художественного замысла: как устроено пространство, для чего нужны его элементы и как они связаны с общей концепцией. На основе брифа составил итоговый чек-лист для обратной связи клиентов."]},{"title":"Переход к комплектации","paragraphs":["С самого начала выстраивал презентацию с двумя целями: помочь согласовать интерьер и подвести владельцев к покупке следующей услуги бюро — комплектации объекта. Предпоследний и последний слайды были точкой, к которой вёл весь рассказ.","В разделах о помещениях связал визуализации с конкретными решениями и материалами: клиент должен понимать, что именно ему предстоит реализовать. Затем показал ориентировочное распределение бюджета, преимущества комплектации с бюро и понятный состав дальнейшей работы — согласование концепции, подбор поставщиков и образцов, спецификации мебели и освещения."]}],"outcome":["Подготовил презентацию на 17 страницах за два дня.","По оценке дизайнера проекта, за первое обсуждение удалось закрыть около 90% вопросов клиентов; оставшиеся передали на доработку.","По словам дизайнера проекта, с помощью этой презентации он продал клиентам дальнейшую услугу комплектации. Рассказ помог одновременно согласовать интерьер и показать ценность продолжения работы с бюро."],"credits":"Бриф, структура, оформление презентации и чек-лист — моя работа. Интерьер, планы и рендеры созданы авторами интерьерного проекта. Оценка результатов встречи и сведения о заказе комплектации — со слов дизайнера проекта.","stat":{"value":"2 дня","label":"на подготовку презентации из 17 страниц"}}}]]
