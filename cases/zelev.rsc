1:[[["$","$Lb",null,{"className":"skip-link","href":"#main","children":"К содержанию"}],["$","header",null,{"className":"archive-header","children":[["$","div",null,{"className":"archive-brand","children":[["$","$Lc",null,{}],["$","$Lb",null,{"className":"portfolio-home mono","href":"/","aria-label":"Портфолио — на главную","children":"ПОРТФОЛИО"}]]}],["$","nav",null,{"aria-label":"Основная навигация","children":[["$","$Lb",null,{"href":"/#portfolio","children":"Работы"}],["$","$Lb",null,{"href":"/about","children":"Обо мне"}],["$","$Lb",null,{"href":"https://t.me/Alexzrm","target":"_blank","rel":"noreferrer","children":["Telegram ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}]],["$","$L10","zelev",{"project":{"slug":"zelev","number":"04","title":"«Павелецкая Сити» — презентация интерьера","shortTitle":"«Павелецкая Сити»","group":"concepts","discipline":"Структура · Презентация · Коммуникация","summary":"Презентация интерьерного проекта: последовательное обсуждение помещений, решений, бюджета и комплектации.","role":"Бриф, систематизация материалов, структура, дизайн и форма обратной связи","client":"Zelev Bureau","format":"Фриланс · Презентация интерьерного проекта","context":["Заказчикам интерьерного проекта было трудно оценить решения по отдельным рендерам и коротким пояснениям. В ходе обсуждений появлялись новые пожелания, а согласование затягивалось. Дизайнер интерьера обратился ко мне за структурой и визуальной подачей презентации.","Задача состояла в том, чтобы последовательно объяснить планировочные и художественные решения, собрать обратную связь и обозначить следующий этап работы."],"sections":[{"title":"Структура обсуждения","paragraphs":["Провёл бриф с дизайнером интерьера и систематизировал визуализации и голосовые пояснения. Выстроил презентацию по помещениям, чтобы обсуждать решения в контексте каждого пространства.","Визуализации сопровождались пояснениями функционала и художественного замысла: как устроено пространство, для чего нужны его элементы и как они связаны с общей концепцией. На основе брифа составил итоговый чек-лист для обратной связи клиентов."]},{"title":"Переход к комплектации","paragraphs":["Презентация решала две задачи: согласование интерьера и представление услуги комплектации. Финальные слайды связывали утверждение концепции с её последующей реализацией.","В разделах о помещениях связал визуализации с конкретными решениями и материалами. Далее представил ориентировочное распределение бюджета и состав комплектации: согласование концепции, подбор поставщиков и образцов, подготовку спецификаций мебели и освещения."]}],"outcome":["Подготовил презентацию на 17 страницах за два дня.","По оценке дизайнера проекта, за первое обсуждение удалось закрыть около 90% вопросов клиентов; оставшиеся передали на доработку.","По словам дизайнера проекта, с помощью этой презентации он продал клиентам дальнейшую услугу комплектации. Рассказ помог одновременно согласовать интерьер и показать ценность продолжения работы с бюро."],"credits":"Бриф, структура, оформление презентации и чек-лист — моя работа. Интерьер, планы и рендеры созданы авторами интерьерного проекта. Оценка результатов встречи и сведения о заказе комплектации — со слов дизайнера проекта.","stat":{"value":"2 дня","label":"на подготовку презентации из 17 страниц"}}}]]
